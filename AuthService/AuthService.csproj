<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Net8.0-windows</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Explicit <Compile> list is authoritative in every configuration (incl. the
         Debug config that flows in from a referencing test project); prevents SDK
         default-item collisions. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Configurations>Net Framework 4.7;Net Framework 4.8.1;Net8.0-windows</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
	 <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Net Framework 4.7|AnyCPU' ">
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>embedded</DebugType>
	  <Optimize>false</Optimize>
	  <OutputPath>bin\Net Framework 4.7\</OutputPath>
	  <DefineConstants>DEBUG;_NET_47</DefineConstants>
	  <TargetFramework>net47</TargetFramework>
	  <AssemblyName>$(AssemblyName)</AssemblyName>
	  <LangVersion>latest</LangVersion>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  <StartAction>Program</StartAction>
	  <EnableDefaultEmbeddedResourseItems>false</EnableDefaultEmbeddedResourseItems>
	  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Net Framework 4.8.1|AnyCPU' ">
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>embedded</DebugType>
	  <Optimize>false</Optimize>
	  <OutputPath>bin\Net Framework 4.8.1\</OutputPath>
	  <DefineConstants>DEBUG;_NET_481</DefineConstants>
	  <TargetFramework>net48</TargetFramework>
	  <AssemblyName>$(AssemblyName)</AssemblyName>
	  <LangVersion>latest</LangVersion>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  <StartAction>Program</StartAction>
	  <EnableDefaultEmbeddedResourseItems>false</EnableDefaultEmbeddedResourseItems>
	  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Net8.0-windows|AnyCPU' ">
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>embedded</DebugType>
	  <Optimize>false</Optimize>
	  <OutputPath>bin\Net8.0-windows\</OutputPath>
	  <DefineConstants>DEBUG;_NET_8</DefineConstants>
	  <TargetFramework>net8.0-windows</TargetFramework>
	  <AssemblyName>$(AssemblyName)</AssemblyName>
	  <LangVersion>latest</LangVersion>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  <StartAction>Program</StartAction>
	  <EnableDefaultEmbeddedResourseItems>false</EnableDefaultEmbeddedResourseItems>
	  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
	<ItemGroup Condition=" '$(TargetFramework)' != 'net8.0-windows' ">
		<Reference Include="PresentationCore" />
		<Reference Include="WindowsBase" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System.Xaml" />
	</ItemGroup>
  <ItemGroup>
    <Compile Include="Auth.cs" />
    <Compile Include="Commands\RelayCommand.cs" />
    <Compile Include="MVVM\Models\ApiResponseGet.cs" />
    <Compile Include="MVVM\ViewModel\AuthViewModel.cs" />
    <Compile Include="MVVM\ViewModel\ViewModelBase.cs" />
	  <Compile Include="MVVM\View\AuthWindow.xaml.cs">
		  <DependentUpon>MVVM\View\AuthWindow.xaml</DependentUpon>
	  </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\DependencyResolver.cs" />
    <Compile Include="Services\DateHelper.cs" />
    <Compile Include="Services\DateTimeConverter.cs" />
    <Compile Include="Services\SubscriptionService.cs" />
    <Compile Include="Services\Validiation.cs" />
    <Compile Include="Services\Licensing\DeviceFingerprint.cs" />
    <Compile Include="Services\Licensing\LicenseBlobCodec.cs" />
    <Compile Include="Services\Licensing\RollbackRatchet.cs" />
    <Compile Include="Services\Licensing\LicenseStore.cs" />
    <Compile Include="Services\Licensing\LicenseGate.cs" />
    <Compile Include="Services\Licensing\ActivationInput.cs" />
    <Compile Include="Services\Licensing\MintClient.cs" />
    <Compile Include="Services\Licensing\LegacyActivationClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- The JWT/crypto verifier is a separate assembly kept OUT of obfuscation.
       Referencing it here pulls its output (AuthService.Tokens.dll) and the
       IdentityModel DLLs into this project's output folder, where the
       DependencyResolver can probe them by assembly name at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\AuthService.Tokens\AuthService.Tokens.csproj" />
  </ItemGroup>

